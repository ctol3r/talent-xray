{
  "name": "talentos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:seed": "tsx src/lib/db/seed-cli.ts",
    "e2e": "playwright test",
    "smoke": "tsx scripts/critical-path.mts",
    "golden:cais": "tsx scripts/golden-cais.mts",
    "golden:session": "tsx scripts/golden-cais-session.mts",
    "crew:work": "tsx scripts/crew-worker.mts",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm build:artifact:check && pnpm test && pnpm build && pnpm check:private-build",
    "eval:w12": "tsx scripts/eval-w12.mts",
    "eval:w12:fulfil": "tsx scripts/eval-w12-fulfil.mts",
    "build:artifact": "tsx scripts/build-artifact.mts",
    "build:artifact:check": "tsx scripts/build-artifact.mts --check",
    "e2e:artifact": "playwright test -c playwright.artifact.config.ts",
    "test:documents:defects": "tsx scripts/check-document-defects.mts",
    "check:private-build": "tsx scripts/check-private-build.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "seed:sp104": "tsx src/lib/hsal/seed-sp104-cli.ts",
    "demo:sp104": "tsx scripts/demo-sp104.mts",
    "hsal:vendor": "pnpm --dir ../../hsal sdk:vendor \"$(pwd)/vendor\" && pnpm install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "mammoth": "^1.12.2",
    "next": "16.3.2",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4",
    "@talentos/hsal-adapter": "workspace:*",
    "@hsal/sdk": "file:vendor/@hsal/sdk"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.17.1"
}
