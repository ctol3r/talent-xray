# ── Model provider ────────────────────────────────────────────────────────────
# Which model provider to use:
#   "anthropic" (default) — Anthropic API; requires ANTHROPIC_API_KEY below.
#   "session"             — no API key: generations are written as request files
#                           to the outbox and fulfilled by a Claude Code /
#                           claude.ai session (covered by your Claude
#                           subscription). See docs/DECISIONS.md D-008.
#   "mock"                — tests/dev only; output is watermarked, never
#                           presented as real analysis.
TALENTOS_MODEL_PROVIDER=anthropic

# Outbox directory for the "session" provider's file handoff.
TALENTOS_SESSION_OUTBOX=./data/session-outbox

# Anthropic API key. Server-side only; never exposed to the client.
# With no key set, every AI feature shows a "provider not configured" state —
# nothing is faked.
ANTHROPIC_API_KEY=

# Model override (default: claude-opus-5)
TALENTOS_MODEL=claude-opus-5

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite database file. Default: ./data/talentos.db (created on first run).
# Back up by copying this one file.
TALENTOS_DATABASE_PATH=./data/talentos.db

# ── Candidate discovery provider (people search, D-010) ──────────────────────
# "talent-xray" (default) — live people-only discovery through the two Talent
# X-Ray Programmable Search engines (Discover tab). Bring your own Google
# Custom Search JSON API key; the provider reports "not configured" until the
# key is set. "none" disables discovery. Result pages are never fetched, only
# results you explicitly save are stored, and saved snippets are labeled
# unverified source evidence — never resume content.
TALENTOS_DISCOVERY_PROVIDER=talent-xray
TALENTOS_GOOGLE_CSE_KEY=
# Engine overrides (default: the live Talent X-Ray engines)
# TALENTOS_CSE_CORE_CX=a157d37906e1141cc
# TALENTOS_CSE_REACH_CX=918bc00e18d0c46e5

# ── Research provider (general information environment, D-010/D-013) ────────
# Separate boundary from candidate discovery: profession/company/market and
# AUDIENCE research (personas before outreach). Values:
#   "session" — a Claude session performs the web search via the same outbox
#               file handoff as the session model provider (no key)
#   "mock"    — tests only; watermarked fixture findings, never real research
#   "none"    — no backend; personas and outreach stop with an honest error
# Unset: follows the model provider (session → session, mock → mock, else
# none). The people-only engines above are deliberately not accepted here.
TALENTOS_RESEARCH_PROVIDER=
