# ── Model provider ────────────────────────────────────────────────────────────
# Which model provider to use:
#   "anthropic" (default) — Anthropic API; requires ANTHROPIC_API_KEY below.
#   "session"             — no API key: generations are written as request files
#                           to the outbox and fulfilled by a Claude Code /
#                           claude.ai session (covered by your Claude
#                           subscription). See docs/DECISIONS.md D-008.
#   "mock"                — tests/dev only; output is watermarked, never
#                           presented as real analysis.
TALENTOS_MODEL_PROVIDER=anthropic

# Outbox directory for the "session" provider's file handoff.
TALENTOS_SESSION_OUTBOX=./data/session-outbox

# Anthropic API key. Server-side only; never exposed to the client.
# With no key set, every AI feature shows a "provider not configured" state —
# nothing is faked.
ANTHROPIC_API_KEY=

# Model override (default: claude-opus-5)
TALENTOS_MODEL=claude-opus-5

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite database file. Default: ./data/talentos.db (created on first run).
# Back up by copying this one file.
TALENTOS_DATABASE_PATH=./data/talentos.db

# ── Research provider ────────────────────────────────────────────────────────
# "none" (default) or "google-cse" — live people-only discovery through the
# two Talent X-Ray Programmable Search engines (Discover tab). Bring your own
# Google Custom Search JSON API key; result pages are never fetched, and only
# results you explicitly save are stored.
TALENTOS_RESEARCH_PROVIDER=none
TALENTOS_GOOGLE_CSE_KEY=
# Engine overrides (default: the live Talent X-Ray engines)
# TALENTOS_CSE_CORE_CX=a157d37906e1141cc
# TALENTOS_CSE_REACH_CX=918bc00e18d0c46e5
